// Container specifications for the Docker profile

docker.fixOwnership = true
docker {
    enabled = true
    runOptions = '--platform linux/amd64'
}
process {
    withLabel: 'blast_container' {
        container = 'ncbi/blast:2.16.0'
        cpus = 16
        memory = '16GB'
    }
    withLabel: "parse_results" {
        container = "community.wave.seqera.io/library/argparse_biopython_pandas:a321277b39d35895"
        memory = '20GB'  // Reduce from 30GB to 20GB
        mount = ['/Users/sathyajali/Documents/RemoteBlast_nr_nt/bin:/work/bin']
        beforeScript = 'pip install openpyxl'
    }
}
